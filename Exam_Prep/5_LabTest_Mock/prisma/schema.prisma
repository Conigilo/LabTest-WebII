generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// โมเดลสำหรับผู้ใช้งานระบบ (เอาไว้ทำการ Login)
model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String   // ตามหลักต้องใส่รหัสที่ถูก Hash (แต่เพื่อ Lab Test เราอาจจะละไว้ถ้าไม่ได้บังคับ)
}

// โมเดลข้อมูลหนังสือ
model Book {
  id            Int      @id @default(autoincrement())
  title         String
  author        String
  price         Float
  stock         Int      @default(0)
  publishedYear Int?     // ? หมายถึงเป็นค่าว่าง/ส่งเข้ามาภายหลังได้ (optional)
}
